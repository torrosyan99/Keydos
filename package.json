{
    "name": "kkeydos-homepage",
    "version": "1.0.0",
    "private": true,
    "description": "Production-ready KKEYDOS homepage prototype for Laravel integration",
    "scripts": {
        "build:icons": "node ./scripts/build-icons.mjs",
        "build:css": "tailwindcss -i ./src/input.css -o ./assets/styles/main.css --minify",
        "dev:css": "tailwindcss -i ./src/input.css -o ./assets/styles/main.css --watch",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "devDependencies": {
        "@tailwindcss/cli": "^4.3.3",
        "aos": "2.3.4",
        "lucide-static": "^1.41.0",
        "prettier": "^3.9.6",
        "simple-icons": "^16.29.0",
        "tailwindcss": "^4.3.3"
    },
    "dependencies": {
        "marquee6k": "^1.3.4",
        "swiper": "^14.2.0"
    }
}
